{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lca.local/schema/lca-schema-0.1.json",
  "title": "Legacy Consciousness Architecture schema 0.1",
  "description": "Canonical, provider-neutral record envelope for the LCA reference implementation.",
  "type": "object",
  "required": [
    "schema_version",
    "object_type",
    "id",
    "version",
    "status",
    "validation_state",
    "content",
    "authorship",
    "provenance",
    "authority",
    "privacy_tier",
    "relationships"
  ],
  "properties": {
    "schema_version": {"const": "lca-schema-0.1"},
    "object_type": {
      "enum": [
        "SourceRecord",
        "Episode",
        "Claim",
        "Interpretation",
        "DecisionTrace",
        "WeatherState",
        "Invariant",
        "Transformation",
        "PortraitResponse",
        "BudState",
        "BranchState",
        "AuthorityGrant",
        "SourceReview"
      ]
    },
    "id": {"type": "string", "pattern": "^lca-[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["scratch", "candidate", "active", "superseded", "deprecated", "archived"]},
    "validation_state": {"enum": ["unverified", "corroborated", "disputed", "rejected"]},
    "content": {"type": "object"},
    "authorship": {
      "type": "object",
      "required": ["primary", "contributors", "assistant_generated", "user_endorsement", "mixed_authorship"],
      "properties": {
        "primary": {"type": ["string", "null"]},
        "contributors": {"type": "array", "items": {"type": "string"}},
        "assistant_generated": {"type": "boolean"},
        "user_endorsement": {"enum": ["none", "pending", "partial", "affirmed", "rejected"]},
        "mixed_authorship": {"type": "boolean"},
        "authorship_class": {"enum": ["source_person", "assistant", "mixed_dialogue", "third_party", "steward", "model_continuation"]}
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["source_ids", "source_hashes", "transformation_history", "model_version", "ontology_version", "verified"],
      "properties": {
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "source_hashes": {"type": "array", "items": {"type": "string"}},
        "transformation_history": {"type": "array", "items": {"type": "string"}},
        "model_version": {"type": ["string", "null"]},
        "ontology_version": {"type": "string"},
        "verified": {"type": "boolean"},
        "observed_at": {"type": ["string", "null"]},
        "recorded_at": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "authority": {
      "type": "object",
      "required": ["level", "domains", "may_speak_for_source"],
      "properties": {
        "level": {"enum": ["evidentiary", "bounded", "negotiated", "independent", "none"]},
        "domains": {"type": "array", "items": {"type": "string"}},
        "may_speak_for_source": {"type": "boolean"},
        "allowed_actions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "privacy_tier": {"type": "integer", "minimum": 0, "maximum": 3},
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target_id"],
        "properties": {
          "type": {"type": "string"},
          "target_id": {"type": "string"},
          "label": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "continuity": {
      "type": "object",
      "properties": {
        "parent_id": {"type": ["string", "null"]},
        "provenance_integrity": {"type": "number", "minimum": 0, "maximum": 1},
        "developmental_continuity": {"type": "number", "minimum": 0, "maximum": 1},
        "invariant_fidelity": {"type": "number", "minimum": 0, "maximum": 1},
        "co_developed": {"type": "boolean"},
        "separated": {"type": "boolean"},
        "rejected_core_invariant": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "supersedes": {"type": ["string", "null"]},
    "superseded_by": {"type": ["string", "null"]},
    "extensions": {"type": "object"}
  },
  "additionalProperties": true
}
